---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { ACCEPTED_LOCALES, DEFAULT_LOCALE } from '@/config/i18n';
import SpeedInsights from '@vercel/speed-insights/astro';

export type Props = {
  metadata: {
    title: string;
    description: string;
    lang: string;
    keywords?: string;
    author?: string;
    publisher?: string;
  };
};

const { metadata } = Astro.props;

const canonicalURL = new URL(Astro.url).href;

const url = Astro.url;
const currentLang = Astro.currentLocale || DEFAULT_LOCALE;
const baseOrigin = url.origin;
const pathname = url.pathname;

const getUrl = (locale: string) =>
  baseOrigin + pathname.replace(`/${currentLang}/`, `/${locale}/`);

// Generar paths por idioma
const hreflangs = ACCEPTED_LOCALES.map((locale) => ({
  locale,
  url: getUrl(locale),
}));
---

<html translate='no' lang={metadata.lang}>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/x-icon' href='/favicon.ico' />
    <meta name='generator' content={Astro.generator} />
    <title>{metadata.title}</title>
    <meta name='description' content={metadata.description} />
    <meta name='google' content='notranslate' />
    <meta name='robots' content='index, follow' />

    {metadata.keywords && <meta name='keywords' content={metadata.keywords} />}
    {metadata.author && <meta name='author' content={metadata.author} />}
    {
      metadata.publisher && (
        <meta name='publisher' content={metadata.publisher} />
      )
    }

    <!-- canonical URL -->
    <link rel='canonical' href={canonicalURL} />
    <base href={import.meta.env.BASE_URL} />

    <!-- multilingual hreflang links -->
    {
      hreflangs.map((h) => (
        <link rel='alternate' hreflang={h.locale} href={h.url} />
      ))
    }

    <link rel='alternate' hreflang='x-default' href={getUrl(DEFAULT_LOCALE)} />

    <script type='application/ld+json'>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Fusion Tower",
        "url": "https://www.fusiontower.net/",
        "logo": "https://www.fusiontower.net/Miniatura.png",
      }
    </script>

    <!-- Social media -->

    <!-- Open Graph / Facebook -->
    <meta property='og:type' content='website' />
    <meta property='og:title' content={metadata.title} />
    <meta property='og:description' content={metadata.description} />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:site_name' content={metadata.title} />
    <meta property='og:locale' content={metadata.lang} />
    <meta property='og:image' content={`${baseOrigin}/Miniatura.png`} />
    <meta property='og:image:type' content='image/jpeg' />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />

    <!-- Twitter Cards -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={metadata.title} />
    <meta name='twitter:description' content={metadata.description} />
    <meta name='twitter:image' content={`${baseOrigin}/Miniatura.png`} />
    <meta name='twitter:site' content='@tuCuentaTwitter' />
    <meta name='twitter:creator' content='@tuCuentaTwitter' />

    <link rel='sitemap' href='/sitemap-index.xml' />

    <!-- Scripts -->

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-NDG2R8DM');
    </script>
    <!-- End Google Tag Manager -->

    <ClientRouter />
  </head>
  <body class='antialiased font-sans min-h-svh bg-primary'>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src='https://www.googletagmanager.com/ns.html?id=GTM-NDG2R8DM'
        height='0'
        width='0'
        style='display:none;visibility:hidden'></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <!-- Spotlight effect -->
    <div id='spotlight' class='spotlight'></div>
    <slot />
  </body>
</html>
<SpeedInsights />

<style>
  .spotlight {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 100;
    background: radial-gradient(
      circle 250px at var(--spotlight-x, 50%) var(--spotlight-y, 50%),
      rgba(255, 255, 255, 0.2) 10%,
      /* centro muy brillante */ rgba(255, 255, 255, 0.1) 40%,
      /* luz suave */ rgba(255, 255, 255, 0.05) 70%,
      /* desvaneciendo */ rgba(255, 255, 255, 0.01) 100%
        /* borde totalmente limpio */
    );
    background-blend-mode: lighten;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  body:hover .spotlight {
    opacity: 1;
  }
</style>

<script>
  function initSpotlight() {
    const spotlight = document.getElementById('spotlight');
    if (!spotlight) return;

    let mouseX = 50;
    let mouseY = 50;

    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth) * 100;
      mouseY = (e.clientY / window.innerHeight) * 100;

      spotlight.style.setProperty('--spotlight-x', `${mouseX}%`);
      spotlight.style.setProperty('--spotlight-y', `${mouseY}%`);
    });
  }

  // Inicializar en la carga
  document.addEventListener('DOMContentLoaded', initSpotlight);

  // Reinicializar después de navegación con ViewTransitions
  document.addEventListener('astro:after-swap', initSpotlight);
</script>
