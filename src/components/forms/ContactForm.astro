---
import { getLangFromUrl, useTranslationsObject } from '@/config/i18n';
import SectionContainer from '../common/SectionContainer.astro';
import Input from './Input.astro';
import Button from '../common/Button.astro';
import Select from './Select.astro';
import { useServiceContentOrganized } from '@/helpers/useServiceContent';
import ContactFormWrapper from './ContactFormWrapper';

const lang = getLangFromUrl(Astro.url);

const t = useTranslationsObject(lang);

const { serviceData } = useServiceContentOrganized(t);

const requieredText = (text: string) => `${text}*`;
---

<SectionContainer
  class='items-center pb-14 sm:pb-20 h-auto pt-20'
  id='contact-form-container'
  containerClass='!pt-5 sm:!pt-20'
>
  <h1
    class='font-lexend uppercase text-[64px] font-normal text-text-secondary mb-20'
  >
    {t.contact.title}
    <br />
    <span class='text-secondary'>
      {t.contact.question}
    </span>
  </h1>

  <ContactFormWrapper texts={t.contact.form} client:load>
    <fieldset
      class='grid grid-cols-1 gap-6 mb-7 sm:grid-cols-2 sm:gap-[74px] sm:mb-14'
    >
      <Input
        required
        placeholder={requieredText(t.contact.inputs.name)}
        type='text'
        name='name'
        minlength={2}
        autocomplete='name'
      />
      <Input
        required
        placeholder={requieredText(t.contact.inputs.email)}
        type='email'
        name='email'
        autocomplete='email'
      />
      <Select
        required
        placeholder={requieredText(t.contact.inputs.service)}
        name='service'
        options={serviceData.map((service) => ({
          value: service.title,
          label: service.title,
        }))}
      />
      <Input
        required
        placeholder={requieredText(t.contact.inputs.message)}
        type='text'
        name='message'
        minlength={2}
      />
    </fieldset>
    <Button type={'submit'} class={'w-full'}>{t.contact.submit}</Button>
  </ContactFormWrapper>
</SectionContainer>

<style>
  :global(#contact-form-container) {
    /* background-image: var(--banner-gradient); */
    background: linear-gradient(259.77deg, #051a34 6.25%, #104c9a 92.04%);
    padding-top: 104px;
  }
</style>
