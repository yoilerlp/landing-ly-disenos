---
import { cn } from '@/helpers/cn';

export type WorkFlowCardProps = {
  step: {
    label: string;
    title: string;
    description: string;
  };
  Icon: any;
  class?: string;
};

const { step, Icon, class: className } = Astro.props as WorkFlowCardProps;
---

<article class={cn('flex items-center gap-28', className)}>
  <section class='w-full sm:w-[360px]'>
    <p
      class='font-lexend font-light text-base mb-1.5 sm:text-xl sm:leading-6 uppercase text-text-gray sm:mb-3'
    >
      {step.label}
    </p>

    <p
      class='font-lexend font-light text-[21px] mb-3 leading-normal sm:text-2xl sm:leading-[30px] uppercase text-secondary sm:mb-[22px]'
    >
      {step.title}
    </p>

    <p class='font-lexend-deca font-light text-[14px] sm:text-xl text-white'>
      {step.description}
    </p>
  </section>

  {
    Icon && (
      <section class='w-[140px] h-[154px] border border-border rounded-[20px] bg-primary flex items-center justify-center'>
        <Icon />
      </section>
    )
  }
</article>
