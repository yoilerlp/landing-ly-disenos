---
import { useWorkFlowContentOrganized } from '@/helpers/useWorkFlowContent';
import WorkFlowCard from './WorkFlowCard.astro';
import { getLangFromUrl, useTranslationsObject } from '@/config/i18n';
import { getDescriptionLines } from '@/helpers/text';
import { cn } from '@/helpers/cn';
import { groupBy } from '@/helpers/ultils';

const lang = getLangFromUrl(Astro.url);

const t = useTranslationsObject(lang);

const { workFlowSteps, workFlowIcons } = useWorkFlowContentOrganized(t);

const workFlowStepsGrouped = groupBy(workFlowSteps, 2);
---

<section class='flex-col p-2 sm:p-5 h-svh max-xl:mb-3' id='our-workflow'>
  <div
    class={cn(
      'p-16! overflow-hidden border-border h-[700px] bg-blue-medium border rounded-[20px]',
      'max-sm:h-auto! max-sm:p-0! max-sm:border-0! max-sm:bg-transparent'
    )}
  >
    <h4
      class='font-lexend font-light uppercase leading-10 text-[32px] text-text-gray mb-24 max-sm:hidden'
      set:html={getDescriptionLines(t?.workflow?.title)}
    />

    <div class='hidden sm:flex gap-32' id='workflow-steps-list'>
      {
        workFlowSteps.map((step, idx) => {
          const Icon = workFlowIcons[idx];
          return <WorkFlowCard step={step} stepNumber={idx + 1} Icon={Icon} />;
        })
      }
    </div>

    <div class='sm:hidden flex gap-3.5' id='workflow-steps-list-mobile'>
      {
        workFlowStepsGrouped.map((group, groupIdx) => {
          const groupSize = group.length;
          const allIcons = workFlowIcons.slice(
            groupIdx * 2,
            groupIdx * 2 + groupSize
          );

          return (
            <div
              class={cn(
                'w-[300px] shrink-0 p-6 pb-12 flex flex-col gap-5 border-border bg-blue-medium border rounded-[20px]'
              )}
            >
              {group.map((step, idx) => {
                const globalIdx = groupIdx * 2 + idx;
                return (
                  <div>
                    <WorkFlowCard
                      class='odd:mb-6'
                      step={step}
                      stepNumber={globalIdx + 1}
                    />
                    {idx === 0 && group.length > 1 ? (
                      <div class='h-24 border border-border rounded-[20px] bg-primary flex items-center justify-evenly'>
                        {allIcons?.map((Icon, iconIdx) => (
                          <img
                            src={Icon.src}
                            alt={`Step ${globalIdx + iconIdx + 1} Icon`}
                            class="max-w-[60px] max-h-[66px]"
                          />
                        ))}
                      </div>
                    ) : null}
                  </div>
                );
              })}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const isMobile = window.matchMedia('(max-width: 640px)').matches;

  function init() {
    const section = document.querySelector('#our-workflow');

    const container = document.querySelector(
      isMobile ? '#workflow-steps-list-mobile' : '#workflow-steps-list'
    );

    if (section && container) {
      const totalScrollWidth = container.scrollWidth;
      const viewportWidth = window.innerWidth;
      const scrollDistance = totalScrollWidth - viewportWidth + 300;

      gsap.to(container, {
        x: -scrollDistance,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top 10%',
          end: () => `+=${scrollDistance}`,
          scrub: true,
          pin: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
    }
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  :global(#our-workflow) {
    background-image: var(--bg-mesa);
  }
</style>
