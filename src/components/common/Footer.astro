---
import Link from '@/components/common/Link.astro';
import Button from '@/components/common/Button.astro';
import { icons } from '@/assets';
import FusionTowerFooter from '@/assets/images/FusionTowerFooter.svg';
import FusionTowerFooterMobileOne from '@/assets/icons/FusionTowerFooterMobile1.svg';
import FusionTowerFooterMobileTwo from '@/assets/icons/FusionTowerFooterMobile2.svg';
import {
  DEFAULT_LOCALE,
  getLangFromUrl,
  useTranslationsObject,
} from '@/config/i18n';
import { withLocale } from '@/helpers/withLocale';
import ModalGame from '../ModalGame';

const lang = getLangFromUrl(Astro.url);
const t = useTranslationsObject(lang);

const currentLocale = Astro.currentLocale || DEFAULT_LOCALE;
---

<footer class='p-5 max-xl:px-4'>
  <section
    class='flex flex-col gap-[30px] xl:flex-row justify-between items-center mb-12 pt-4'
  >
    <div class='flex gap-9 items-center'>
      <Link href={withLocale(currentLocale, '/')}>{t.footer.home}</Link>
      <Link href={withLocale(currentLocale, '/contact')}
        >{t.footer.contactUs}</Link
      >
    </div>

    <!-- <div class='flex gap-6 items-center'>
      <Link href={'www.facebook.com/fusiontower'}>
        <img src={icons.FacebookIcon.src} alt='Facebook' />
      </Link>
      <Link href={'www.facebook.com/fusiontower'}>
        <img src={icons.InstagramIcon.src} alt='Instagram' />
      </Link>
      <Link href={'www.facebook.com/fusiontower'}>
        <img src={icons.LinkedinIcon.src} alt='LinkedIn' />
      </Link>
    </div> -->
  </section>

  <section class='px-3 mb-[70px]'>
    <FusionTowerFooter class='w-full h-auto hidden xl:block' />
    <div class='flex flex-col items-center xl:hidden'>
      <FusionTowerFooterMobileOne />
      <FusionTowerFooterMobileTwo />
    </div>
  </section>

  <section
    class='flex flex-col max-sm:items-center max-sm:text-center xl:flex-row justify-between items-center mb-11'
  >
    <p
      class='font-lexend-deca font-medium max-sm:text-[10px] text-[16px] uppercase leading-6 text-secondary'
    >
      {t.footer.copyRight}
    </p>

    <Link
      class='max-sm:text-[12px]'
      href={withLocale(currentLocale, '/privacy')}
      >{t.footer.privacyPolicy}</Link
    >
  </section>

  <section class='h-[400px] flex flex-col items-center pt-[120px]'>
    <h5
      class='font-lexend max-sm:text-[32px] text-center text-[40px] text-secondary leading-12 mb-7'
    >
      {t.footer.moreBeforeYouGo}
    </h5>
    <Button id='showMeButton'>{t.footer.showMe}</Button>
  </section>

  <ModalGame client:load />
</footer>

<style is:global>
  footer,
  #modal-game {
    background-image: var(--bg-mesa);
  }
</style>

<script>
  import { openModalGame } from '@/helpers/game';

  const setupOpenGameLogic = () => {
    const btnOpenGame = document.getElementById(
      'showMeButton'
    ) as HTMLButtonElement;
    if (btnOpenGame) {
      btnOpenGame.addEventListener('click', () => {
        openModalGame();
      });
    }
  };

  setupOpenGameLogic();

  document.addEventListener('astro:after-swap', setupOpenGameLogic);
</script>
