---
import Button from '@/components/common/Button.astro';
import HeaderWrapper from '@/components/common/header/HeaderWrapper.tsx';

import WhatsappIcon from '@/assets/icons/whatsapp.svg';
import FusionTowerIcon from '@/assets/icons/LogoFusionTowerSmall.svg';
import FusionTowerIconMobile from '@/assets/icons/LogoMobile.webp';

import Link from '../Link.astro';
import { withLocale } from '@/helpers/withLocale';
import {
  DEFAULT_LOCALE,
  getLangFromUrl,
  useTranslationsObject,
} from '@/config/i18n';
import { Image } from 'astro:assets';
import LangSwitch from '../LangSwitch.astro';

const currentLocale = Astro.currentLocale || DEFAULT_LOCALE;

const lang = getLangFromUrl(Astro.url);
const t = useTranslationsObject(lang);
---

<LangSwitch slot={'langSwitch'} />
<HeaderWrapper client:load>
  <Link href={withLocale(currentLocale, '/')} class='hidden xl:block'>
    <FusionTowerIcon width={254} height={50} />
  </Link>

  <Link href={withLocale(currentLocale, '/')} class='xl:hidden'>
    <Image
      src={FusionTowerIconMobile}
      alt='Fusion Tower Mobile Logo'
      class='xl:hidden'
    />
  </Link>

  <div class='flex items-center gap-4 max-sm:scale-[0.8]'>
    <a
      href='https://wa.me/573186953119'
      target='_blank'
      rel='noopener noreferrer'
    >
      <WhatsappIcon />
    </a>
    <Link href={withLocale(currentLocale, '/contact')}>
      <Button class={'lowercase'}>{t.footer.contactUs}</Button>
    </Link>
  </div>
</HeaderWrapper>
