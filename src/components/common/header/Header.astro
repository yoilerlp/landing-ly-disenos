---
import Button from '@/components/common/Button.astro';
import HeaderWrapper from '@/components/common/header/HeaderWrapper.tsx';

import WhatsappIcon from '@/assets/icons/whatsapp.svg';
import FusionTowerIcon from '@/assets/icons/LogoFusionTowerSmall.svg';
import Link from '../Link.astro';
import { withLocale } from '@/helpers/withLocale';
import { getLangFromUrl, useTranslationsObject } from '@/config/i18n';

const currentLocale = Astro.currentLocale || 'es';

const lang = getLangFromUrl(Astro.url);
const t = useTranslationsObject(lang);
---

<HeaderWrapper client:load>
  <FusionTowerIcon width={254} height={50} />
  <div class='flex items-center gap-4'>
    <a
      href='https://wa.me/573186953119'
      target='_blank'
      rel='noopener noreferrer'
    >
      <WhatsappIcon />
    </a>
    <Link href={withLocale(currentLocale, '/contact')}>
      <Button class={'lowercase'}>{t.footer.contactUs}</Button>
    </Link>
  </div>
</HeaderWrapper>
